<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
               https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

  <persistence-unit name="javalinky" transaction-type="RESOURCE_LOCAL">

    <!-- 实体类清单。加新实体时记得往这里加一行 -->
    <class>com.example.javalinky.model.Role</class>
    <class>com.example.javalinky.model.User</class>
    <class>com.example.javalinky.model.Post</class>
    <class>com.example.javalinky.model.Follow</class>
    <class>com.example.javalinky.model.Comment</class>

    <!-- 不扫描未列出的类，避免意外 -->
    <exclude-unlisted-classes>true</exclude-unlisted-classes>

    <properties>
      <!-- 表结构由 Flyway 管，Hibernate 只做校验：
           启动时对比实体和真实表结构，不一致就启动失败。
           这能帮你第一时间发现"忘了写迁移"。 -->
      <property name="jakarta.persistence.schema-generation.database.action"
                value="none"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>

      <!-- 连接池 -->
      <property name="hibernate.hikari.maximumPoolSize" value="10"/>
      <property name="hibernate.hikari.minimumIdle" value="2"/>

      <!-- 开发期看 SQL -->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.highlight_sql" value="true"/>

      <!-- 第 16 章：性能观测 -->
      <!-- 超过这个毫秒数的查询会被 org.hibernate.SQL_SLOW 记下来 -->
      <property name="hibernate.log_slow_query" value="500"/>
      <property name="hibernate.generate_statistics" value="true"/>
      <!-- 每条 SQL 执行前都会过一遍这个类：计数 + 记下 SQL 文本 -->
      <property name="hibernate.session_factory.statement_inspector"
                value="com.example.javalinky.db.QueryStats"/>
      <!-- 每个 Session 一个监听器实例：给出 JDBC 执行耗时 -->
      <property name="hibernate.session.events.auto"
                value="com.example.javalinky.db.QueryStats$TimingListener"/>
    </properties>
  </persistence-unit>
</persistence>
