<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 1. 本项目自己的坐标 -->
  <groupId>com.example</groupId>
  <artifactId>javalinky</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <!-- 2. 把版本号集中在一处，后面引用 ${javalin.version} 即可 -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javalin.version>7.2.3</javalin.version>
    <logback.version>1.5.20</logback.version>
    <jte.version>3.2.4</jte.version>
    <!-- exec:exec@cli 的默认参数（不传就打印用法） -->
    <cli.args></cli.args>
    <jackson.version>2.20.0</jackson.version>
    <junit.version>5.14.0</junit.version>
    <assertj.version>3.27.6</assertj.version>
    <hibernate-validator.version>9.0.1.Final</hibernate-validator.version>
    <hibernate.version>7.4.2.Final</hibernate.version>
    <flyway.version>11.14.0</flyway.version>
  </properties>

  <!-- 用 BOM 统一管理一组库的版本。
       Jackson 这一条是必需的：java-jwt 带来 jackson-databind 2.19，
       传递下来的 jackson-core 却是 2.15，运行时会抛
       NoSuchMethodError: BufferRecycler.releaseToPool()。
       导入 jackson-bom 能把整组 jackson 对齐到同一个版本。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- 3. 依赖 -->
  <dependencies>
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin</artifactId>
      <version>${javalin.version}</version>
    </dependency>

    <!-- Javalin 只依赖 SLF4J 接口，不带实现。不加这一条启动时会警告“没有日志实现” -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <!-- Javalin 与 JTE 的胶水层：提供 JavalinJte -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin-rendering-jte</artifactId>
      <version>${javalin.version}</version>
    </dependency>

    <!-- JTE 本体（含运行时编译器，开发期热加载需要它） -->
    <dependency>
      <groupId>gg.jte</groupId>
      <artifactId>jte</artifactId>
      <version>${jte.version}</version>
    </dependency>

    <!-- Bean Validation 的参考实现 -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <version>${hibernate-validator.version}</version>
    </dependency>
    <!-- 注解里 message 的表达式求值需要它 -->
    <dependency>
      <groupId>org.glassfish.expressly</groupId>
      <artifactId>expressly</artifactId>
      <version>6.0.0</version>
    </dependency>

    <!-- Hibernate ORM（自带 Jakarta Persistence 接口） -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
    </dependency>

    <!-- 连接池。Hibernate 的这个模块会自动把 HikariCP 接上 -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-hikaricp</artifactId>
      <version>${hibernate.version}</version>
    </dependency>

    <!-- 数据库迁移 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- 开发和测试用：H2，零配置的嵌入式数据库 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
    </dependency>

    <!-- JSON（版本由上面的 jackson-bom 统一管理） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- 没有它，Instant 会被序列化成一个难看的对象 -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Markdown 渲染 -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>0.26.0</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-tables</artifactId>
      <version>0.26.0</version>
    </dependency>

    <!-- HTML 清洗。相当于 Python 的 bleach -->
    <dependency>
      <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
      <artifactId>owasp-java-html-sanitizer</artifactId>
      <version>20240325.1</version>
    </dependency>

    <!-- 造假数据（只在开发环境用） -->
    <dependency>
      <groupId>net.datafaker</groupId>
      <artifactId>datafaker</artifactId>
      <version>2.5.1</version>
    </dependency>

    <!-- 纯 Java 实现的 bcrypt，没有本地库依赖 -->
    <dependency>
      <groupId>at.favre.lib</groupId>
      <artifactId>bcrypt</artifactId>
      <version>0.10.2</version>
    </dependency>

    <!-- 签发/校验确认邮件、重置密码用的令牌 -->
    <dependency>
      <groupId>com.auth0</groupId>
      <artifactId>java-jwt</artifactId>
      <version>4.5.0</version>
    </dependency>

    <!-- Jakarta Mail 的 API + 实现（Angus Mail 自带 API，加一个就够） -->
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>2.0.3</version>
    </dependency>

    <!-- 生产用：PostgreSQL 驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.8</version>
    </dependency>

    <!-- 测试依赖 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Javalin 的测试工具：JavalinTest -->
    <dependency>
      <groupId>io.javalin</groupId>
      <artifactId>javalin-testtools</artifactId>
      <version>${javalin.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- 端到端测试：真浏览器（默认不跑，见下面的 e2e profile） -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>1.57.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- 4. 插件：告诉 Maven 用什么工具干活 -->
  <build>
    <plugins>
      <!-- mvn exec:exec 另起一个 JVM 跑 main 方法，省得手拼 classpath。
           为什么不是 exec:java？见第 3 章：exec:java 在 Maven 自己的 JVM 里用
           独立类加载器跑应用，JTE 运行时编译出来的模板类看不见 gg.jte.*，
           会抛 NoClassDefFoundError: gg/jte/Content。exec:exec 起的是真 JVM，
           和部署时 java -jar 的行为一致。 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>java</executable>
          <!-- %classpath 由插件展开成完整的 classpath -->
          <commandlineArgs>-classpath %classpath com.example.javalinky.App</commandlineArgs>
        </configuration>
        <executions>
          <!-- mvn compile exec:exec@cli -Dcli.args="seed-roles"
               （fake 这类带参数的命令也一样：-Dcli.args="fake 30 60"） -->
          <execution>
            <id>cli</id>
            <configuration>
              <executable>java</executable>
              <commandlineArgs>-classpath %classpath com.example.javalinky.Cli ${cli.args}</commandlineArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 测试一律跑在 TEST 档位：内存库、不发邮件、随机端口 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <environmentVariables>
            <APP_PROFILE>test</APP_PROFILE>
          </environmentVariables>
          <!-- 端到端测试要下载 300 MB 浏览器，默认跳过：mvn -Pe2e test 才跑 -->
          <excludes>
            <exclude>**/e2e/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- 覆盖率 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.50</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <!-- 生成的模板类、入口类不计入 -->
            <exclude>gg/jte/generated/**</exclude>
            <exclude>**/App.class</exclude>
            <exclude>**/Cli.class</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- 把 .jte 模板预编译成 Java 类，打进 jar 里（生产模式不需要运行时编译器）。
           一个执行只能处理一种 ContentType，所以 HTML 和纯文本各来一次。 -->
      <plugin>
        <groupId>gg.jte</groupId>
        <artifactId>jte-maven-plugin</artifactId>
        <version>${jte.version}</version>
        <executions>
          <execution>
            <id>jte-html</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/main/jte</sourceDirectory>
              <contentType>Html</contentType>
              <targetDirectory>${project.build.directory}/generated-sources/jte</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>jte-text</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <sourceDirectory>${basedir}/src/main/jte-text</sourceDirectory>
              <contentType>Plain</contentType>
              <packageName>gg.jte.generated.text</packageName>
              <targetDirectory>${project.build.directory}/generated-sources/jte</targetDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 打一个自带全部依赖的可执行 jar：target/javalinky.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>javalinky</finalName>
              <!-- 有些依赖（例如 bcrypt 用的 Bouncy Castle 风格签名 jar）带数字签名。
                   把几百个 jar 合成一个之后签名必然失效，启动会直接报
                   SecurityException: Invalid signature file digest for Manifest main attributes。
                   所以要把签名文件和重复的 module-info 过滤掉。 -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- 写入 Main-Class，这样 java -jar 才知道从哪开始 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.example.javalinky.App</mainClass>
                </transformer>
                <!-- 合并多个 jar 里同名的 service 描述文件，少了它 Hibernate 会启动失败 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- mvn -Pe2e test：连端到端测试一起跑（需要先装浏览器，见第 15 章） -->
    <profile>
      <id>e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludes combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
